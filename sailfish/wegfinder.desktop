[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=wegfinder
Exec=wegfinder
Name=wegfinder
Comment=Routen, Abfahrten und Verkehrsmittel in der Nähe (inoffiziell)

# Im Sandkasten: Internet (auch der Kachelserver des Netzdienstes auf
# 127.0.0.1), Standort ("Mein Standort", In der Naehe), Downloads (Fussweg
# als GPX fuer Pure Maps). Der Netzdienst laeuft als Kindprozess mit im
# Sandkasten und legt unter ~/.config|.cache|.local/share/org.smatkovi/wegfinder
# ab. Pure Maps ist ueber D-Bus aus dem Sandkasten nicht erreichbar; dann
# gilt der Rueckfall wie in Fahrplan AT (GPX und geo:-Adresse).
[X-Sailjail]
Permissions=Internet;Location;Downloads
OrganizationName=org.smatkovi
ApplicationName=wegfinder
