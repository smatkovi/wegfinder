# Rust und die musl-Cross-Toolchains fuer die drei Ziele.
#
#   . tools/rust.env
#
# Alles unter /tmp/rust (tmpfs; dieselbe Ablage wie bei den Bahn-Ports).
# Nach einem Neustart legt tools/toolchain.sh sie in wenigen Minuten neu an.
#
# Warum statisch gegen musl: Harmattan hat glibc 2.10, gegen die ein Rust-
# Binary nicht bindet; auf Sailfish waere glibc neu genug, aber ein
# statisches Binary haengt an keiner Fassung von OpenSSL oder glibc.
#
#   N9/N950 (armel, softfloat):  armv7-unknown-linux-musleabi
#   Sailfish armv7hl:            armv7-unknown-linux-musleabihf
#   Sailfish aarch64:            aarch64-unknown-linux-musl

export RUSTUP_HOME=${RUSTUP_HOME:-/tmp/rust/rustup}
export CARGO_HOME=${CARGO_HOME:-/tmp/rust/cargo}
export PATH="$CARGO_HOME/bin:$PATH"
RUST=/tmp/rust

# Kisten mit C-Anteil (OpenSSL) brauchen einen Cross-C-Compiler MIT
# musl-Headern -- clang allein faende die x86-glibc-Header des Rechners.
# Gelinkt wird mit rust-lld gegen Rusts eigenes libc.a.
export CC_armv7_unknown_linux_musleabi="$RUST/arm-linux-musleabi-cross/bin/arm-linux-musleabi-gcc"
export AR_armv7_unknown_linux_musleabi="$RUST/arm-linux-musleabi-cross/bin/arm-linux-musleabi-ar"
export CFLAGS_armv7_unknown_linux_musleabi="-march=armv7-a -mfloat-abi=soft"

export CC_armv7_unknown_linux_musleabihf="$RUST/armv7l-linux-musleabihf-cross/bin/armv7l-linux-musleabihf-gcc"
export AR_armv7_unknown_linux_musleabihf="$RUST/armv7l-linux-musleabihf-cross/bin/armv7l-linux-musleabihf-ar"

export CC_aarch64_unknown_linux_musl="$RUST/aarch64-linux-musl-cross/bin/aarch64-linux-musl-gcc"
export AR_aarch64_unknown_linux_musl="$RUST/aarch64-linux-musl-cross/bin/aarch64-linux-musl-ar"

# OpenSSL 3 will auf 32-Bit-ARM beim Binden -latomic (64-Bit-Zaehler), und
# Rusts self-contained-Satz bringt keine mit. Die der jeweiligen musl.cc-
# Toolchain passt -- aber nur sie allein in den Suchpfad, nicht deren libc.a.
for paar in "arm-linux-musleabi-cross/arm-linux-musleabi:atomic-sf" \
            "armv7l-linux-musleabihf-cross/armv7l-linux-musleabihf:atomic-hf"; do
    quelle="$RUST/${paar%%:*}/lib/libatomic.a"
    ziel="$RUST/${paar##*:}"
    if [ -f "$quelle" ] && [ ! -f "$ziel/libatomic.a" ]; then
        mkdir -p "$ziel" && cp "$quelle" "$ziel/"
    fi
done
export CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABI_RUSTFLAGS="-C linker-flavor=ld.lld -C link-self-contained=yes -L native=$RUST/atomic-sf"
export CARGO_TARGET_ARMV7_UNKNOWN_LINUX_MUSLEABIHF_RUSTFLAGS="-C linker-flavor=ld.lld -C link-self-contained=yes -L native=$RUST/atomic-hf"
export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_RUSTFLAGS="-C linker-flavor=ld.lld -C link-self-contained=yes"
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-/tmp/wf-target}
